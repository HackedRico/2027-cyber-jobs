-    r'\b(?:' + '|'.join(SPELLED_YEARS) + r')\s{0,3}\+?\s{0,3}(?:or more\s{1,3})?(?:years?|yrs?)\b')
+    r'\b(' + '|'.join(SPELLED_YEARS) + r')\s{0,3}(\+)?\s{0,3}(or more\s{1,3})?(?:years?|yrs?)\b')
